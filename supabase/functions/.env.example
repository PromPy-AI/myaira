# Set these in Supabase Dashboard > Edge Functions > Secrets, not in Vite.
# Start with Razorpay TEST credentials. Never commit the real values.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# Optional: only if you enable webhook notifications in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
AIRA_ALLOWED_ORIGINS=http://localhost:8080,https://useaira.netlify.app
